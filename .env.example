# Copy this file to .env (in the repository root) and fill in only what the features you turned on need.
# .env is git-ignored. The server reads secrets from it and from nowhere else.
# Each optional feature is switched on in profile/profile.yaml (features:) and documented in docs/.

# ── outreach: people search and email finder (features.outreach, docs/outreach.md) ──────────────
# Paid per use on your own Apify account. Every paid call is logged with its cost (Monitor tab).
APIFY_TOKEN=

# ── email: send approved outreach, read replies and bounces (features.email, docs/email.md) ─────
# Use an app password (Gmail, Outlook, iCloud and Fastmail all offer them), not your login password.
# Only emails you approve are ever sent. Mail is only ever read, never changed: nothing is marked read,
# moved or deleted, and nothing ever replies to anyone.
MAIL_ADDRESS=
MAIL_PASSWORD=
# Gmail: smtp.gmail.com / 465 and imap.gmail.com / 993, sent folder "[Gmail]/Sent Mail".
# Outlook.com: smtp-mail.outlook.com / 587 and outlook.office365.com / 993, sent folder "Sent".
SMTP_HOST=
SMTP_PORT=465
IMAP_HOST=
IMAP_PORT=993
MAIL_SENT_FOLDER=
# Optional: the folder replies are read from (default INBOX). Gmail users who archive mail can use
# "[Gmail]/All Mail"; your own sent mail in it is skipped automatically.
MAIL_INBOX_FOLDER=
# Optional: true files a copy of each sent email in MAIL_SENT_FOLDER, for providers whose SMTP server
# does not do that itself (Gmail and Outlook do; leave it empty for them).
MAIL_SAVE_SENT=

# ── alerts: a Telegram message when something breaks (features.alerts, docs/alerts.md) ─────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

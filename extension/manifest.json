{
  "manifest_version": 3,
  "name": "jd-intake",
  "version": "1.0.0",
  "description": "Capture job postings and send them to your local jd-intake server.",
  "permissions": ["sidePanel", "activeTab", "scripting", "contextMenus", "tabs", "storage", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:8790/*",
    "https://*.linkedin.com/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.ashbyhq.com/*",
    "https://*.myworkdayjobs.com/*"
  ],
  "action": {
    "default_title": "jd-intake"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "capture-job": {
      "suggested_key": {
        "default": "Ctrl+Shift+J",
        "mac": "Command+Shift+J"
      },
      "description": "Capture this job page"
    }
  }
}
